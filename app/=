@app.route("/module/<dept>/<path:item>")
@login_required
def module(dept, item):
    clean_item = item.replace("-", " ").replace("_", " ").title()

    if dept == "Sales" and clean_item == "Customers":
        return redirect(url_for("sales_customers"))
    if dept == "Sales" and clean_item == "Sales Orders":
        return redirect(url_for("sales_orders"))
    if dept == "Production" and clean_item == "Heat Management":
        return redirect(url_for("heat_management"))
    if dept == "Production" and clean_item == "Production Plan":
        return redirect(url_for("production_plans"))
    if dept == "Production" and clean_item == "Job Cards":
        return redirect(url_for("production_job_cards"))

    conn = db()
    entries = conn.execute("""
        SELECT * FROM department_entries 
        WHERE department = ? AND module_name = ? 
        ORDER BY id DESC
    """, (dept, clean_item)).fetchall()
    conn.close()

    return render_template(
        "generic_module.html",
        department=dept,
        module_name=clean_item,
        entries=entries,
        departments=DEPARTMENTS
    )

@app.route("/module/save", methods=["POST"])
@login_required
def save_generic_entry():
    dept = request.form.get("department")
    module_name = request.form.get("module_name")
    ref_no = request.form.get("ref_no")
    item_name = request.form.get("item_name")
    quantity = float(request.form.get("quantity") or 0)
    amount = float(request.form.get("amount") or 0)
    remarks = request.form.get("remarks")

    conn = db()
    conn.execute("""
        INSERT INTO department_entries 
        (department, module_name, ref_no, item_name, quantity, amount, status, remarks, created_by, created_at)
        VALUES (?, ?, ?, ?, ?, ?, 'Draft', ?, ?, ?)
    """, (dept, module_name, ref_no, item_name, quantity, amount, remarks, session["username"], datetime.now().strftime("%Y-%m-%d %H:%M:%S")))
    conn.commit()
    conn.close()

    flash(f"{module_name} entry saved successfully.", "success")
    return redirect(url_for("module", dept=dept, item=module_name.lower().replace(" ", "-")))

